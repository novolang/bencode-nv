// bencwrite — a value back to bytes, and the ordering rule.
//
// Bencode is almost canonical already.  There is one way to write an
// integer, one way to write a byte string and one way to write a list:
// BEP 3 forbids leading zeros and a negative zero, and has no
// whitespace and no escapes.  A value written twice is the same bytes
// twice.
//
// The one exception is a dictionary's order, and BEP 3 resolves it by
// requiring a writer to sort the keys as raw byte strings.  `"Z"`
// sorts before `"a"` because `0x5A` is below `0x61`, so a writer that
// sorted with a locale's collation would produce a different file, and
// for a torrent a different info-hash.
//
// So `write` sorts and `write_as_is` does not, and both are needed.
// Producing a new torrent means sorting, because that is the rule.
// Reproducing a file somebody else wrote means not sorting, because the
// file's own order is what its info-hash was taken over.  The safest
// route for that second job is `bencread.slice`, which hands back the
// original bytes.

use std.bytes
use bencread
use bencvalue

// How many bytes the value will occupy.
//
// The same for `write` and `write_as_is`: sorting changes the order of
// the bytes and not how many there are.
//
// ```novo
// use bencvalue
// use bencwrite
//
// fn main() [io]
//     println("${bencwrite.encoded_len(BencInt(7))}")   // 3
// ```
pub fn encoded_len(v: BencValue) -> Int []
    match v
        BencInt(n)        => str.len(str.from_int(n)) + 2
        BencBytes(b)      => str.len(str.from_int(bytes.len(b))) + 1 + bytes.len(b)
        BencList(items)   =>
            var n = 2
            for item in items
                n += encoded_len(item)
            n
        BencDict(entries) =>
            var n = 2
            for e in entries
                n += str.len(str.from_int(bytes.len(e.key))) + 1 + bytes.len(e.key) + encoded_len(e.value)
            n

// Append a value's encoding to `parts`, sorting every dictionary when
// `sorted` is true.
fn emit(v: BencValue, sorted: Bool, var parts: [Bytes])
    match v
        BencInt(n)        => list.push(parts, bytes.from_str("i${n}e"))
        BencBytes(b)      =>
            list.push(parts, bytes.from_str("${bytes.len(b)}:"))
            list.push(parts, bytes.clone(b))
        BencList(items)   =>
            list.push(parts, bytes.from_str("l"))
            for item in items
                emit(item, sorted, parts)
            list.push(parts, bytes.from_str("e"))
        BencDict(entries) =>
            list.push(parts, bytes.from_str("d"))
            var order = entries[:]
            if sorted
                order = sort_entries(entries)
            for e in order
                list.push(parts, bytes.from_str("${bytes.len(e.key)}:"))
                list.push(parts, bytes.clone(e.key))
                emit(e.value, sorted, parts)
            list.push(parts, bytes.from_str("e"))

// A dictionary's entries in BEP 3's order, keeping the relative order
// of equal keys.
fn sort_entries(entries: [BencEntry]) -> [BencEntry]
    var out: [BencEntry] = []
    for e in entries
        var at = list.len(out)
        while at > 0 and bencvalue.bytes_before(e.key, out[at - 1].key)
            at -= 1
        out = list.concat(list.concat(list.slice(out, 0, at), [e]), list.slice(out, at, list.len(out)))
    out

// The value's bytes, with every dictionary's keys sorted as raw byte
// strings.
//
// BEP 3's rule, applied.  What a program producing a new torrent uses.
//
// ```novo
// use std.bytes
// use bencvalue
// use bencwrite
//
// fn main() [io]
//     println(bytes.to_str(bencwrite.write(BencInt(7))))   // i7e
// ```
pub fn write(v: BencValue) -> Bytes []
    var parts: [Bytes] = []
    emit(v, true, parts)
    bytes.concat(parts)

// The value's bytes, with every dictionary left in the order it is in.
//
// What a program reproducing a file somebody else wrote uses.
//
// ```novo
// use std.bytes
// use bencvalue
// use bencwrite
//
// fn main() [io]
//     println(bytes.to_str(bencwrite.write_as_is(bencvalue.dict())))   // de
// ```
pub fn write_as_is(v: BencValue) -> Bytes []
    var parts: [Bytes] = []
    emit(v, false, parts)
    bytes.concat(parts)

// The value with every dictionary's keys sorted, at every depth.
//
// The sort by itself, so a caller can see what `write` will do.
//
// ```novo
// use bencvalue
// use bencwrite
//
// fn main() [io]
//     println("${bencvalue.keys_sorted(bencwrite.canonical(bencvalue.dict()))}")   // true
// ```
pub fn canonical(v: BencValue) -> BencValue []
    match v
        BencList(items)   =>
            var out: [BencValue] = []
            for item in items
                list.push(out, canonical(item))
            BencList(out)
        BencDict(entries) =>
            var out: [BencEntry] = []
            for e in sort_entries(entries)
                list.push(out, BencEntry { key: bytes.clone(e.key), value: canonical(e.value) })
            BencDict(out)
        _                 => v

// Whether a buffer is exactly what `write` would produce for the value
// it holds.
//
// False for a buffer that does not parse.  A torrent tool asks this
// before it offers to rewrite anything, because a file that answers
// false changes its info-hash if it is re-encoded.
//
// ```novo
// use std.bytes
// use bencwrite
//
// fn main() [io]
//     println("${bencwrite.is_canonical(bytes.from_str("i7e"))}")   // true
// ```
pub fn is_canonical(src: Bytes) -> Bool []
    match bencread.read(src)
        Ok(v)  => write(v) == src
        Err(_) => false

// The byte offset of the first place a buffer differs from its
// canonical form, or `None` when it does not differ.
//
// `None` also for a buffer that does not parse, because a file that is
// not bencode is not non-canonical bencode.
//
// ```novo
// use std.bytes
// use bencwrite
//
// fn main() [io]
//     match bencwrite.first_difference(bytes.from_str("d1:bi1e1:ai2ee"))
//         Some(n) => println("differs at ${n}")   // differs at 1
//         None    => println("already canonical")
// ```
pub fn first_difference(src: Bytes) -> ?Int []
    let Ok(v) = bencread.read(src) else
        return None
    let w = write(v)
    for i in 0..bytes.len(w)
        if bytes.byte_at(w, i) != bytes.byte_at(src, i)
            return Some(i)
    None

// Whether one key sorts before another by BEP 3's rule: as raw byte
// strings, unsigned, shorter first on a common prefix.
//
// It is the one comparison a caller must agree with to produce the
// same file.
//
// ```novo
// use bencwrite
//
// fn main() [io]
//     println("${bencwrite.key_before("Z", "a")}")        // true
//     println("${bencwrite.key_before("info", "name")}")  // true
// ```
pub fn key_before(a: Str, b: Str) -> Bool []
    bencvalue.bytes_before(bytes.from_str(a), bytes.from_str(b))
