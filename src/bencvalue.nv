// bencvalue — the four types, and the dictionary that keeps its order.
//
// Bencode is four types and nothing else (BEP 3).  An integer, written
// `i<digits>e`.  A byte string, written `<length>:<bytes>`.  A list,
// written `l<values>e`.  A dictionary, written `d<key><value>…e`, whose
// keys are byte strings.  There is no boolean, no null and no float.
// A torrent's `private` flag is the integer 1, and its `creation date`
// is Unix seconds as an integer.
//
// A byte string is bytes and not text.  BEP 3 says nothing about the
// encoding of a byte string, and a torrent's `pieces` member is a
// concatenation of twenty-byte SHA-1 digests that is not text in any
// encoding.  So `BencBytes` carries `Bytes`, and `as_str` is a separate
// accessor for a member the caller knows is a name.
//
// A dictionary keeps the order it was read in.  BEP 3 requires a
// writer to sort keys as raw byte strings, and files in the wild do
// not always.  Sorting on read would change the bytes a re-encoding
// produces, and so a torrent's info-hash.  Nothing here sorts;
// `bencwrite.canonical` is where sorting happens.

use std.bytes
use bencerror

// A bencode value.
//
// ```novo
// use bencvalue
//
// fn main() [io]
//     println(bencvalue.type_name(BencInt(7)))   // integer
// ```
pub enum BencValue
    // `i<digits>e`.  Signed and 64-bit; a number too large for that is
    // `BencIntegerOverflow` at the reader rather than a wrapped value.
    BencInt(v: Int)
    // `<length>:<bytes>`.  Bytes, not text.
    BencBytes(v: Bytes)
    // `l<values>e`.
    BencList(items: [BencValue])
    // `d<key><value>…e`, in the order the file has them.
    BencDict(entries: [BencEntry])

// One entry of a dictionary.
//
// The key is `Bytes` and not `Str` for the same reason a value is:
// BEP 3 permits any byte string as a key.  In practice every key in a
// torrent is ASCII, and `key_str` is the accessor that says so.
pub struct BencEntry
    // The key, as the file had it.
    key: Bytes
    // The value.
    value: BencValue

// The type's name, as BEP 3 writes it: `"integer"`, `"string"`,
// `"list"`, `"dictionary"`.
//
// It is what `BencWrongType` reports.
//
// ```novo
// use bencvalue
//
// fn main() [io]
//     println(bencvalue.type_name(BencList([])))   // list
// ```
pub fn type_name(v: BencValue) -> Str []
    match v
        BencInt(_)   => "integer"
        BencBytes(_) => "string"
        BencList(_)  => "list"
        BencDict(_)  => "dictionary"

// A byte-string value from text.
//
// ```novo
// use bencvalue
//
// fn main() [io]
//     println(bencvalue.type_name(bencvalue.text("ubuntu.iso")))   // string
// ```
pub fn text(s: Str) -> BencValue []
    BencBytes(bytes.from_str(s))

// One dictionary entry, with the key given as text.
//
// ```novo
// use bencvalue
//
// fn main() [io]
//     println(bencvalue.key_str(bencvalue.entry("name", BencInt(1))))   // name
// ```
pub fn entry(key: Str, value: BencValue) -> BencEntry []
    BencEntry { key: bytes.from_str(key), value: value }

// An empty dictionary.
//
// ```novo
// use bencvalue
//
// fn main() [io]
//     println("${bencvalue.len(bencvalue.dict())}")   // 0
// ```
pub fn dict() -> BencValue []
    BencDict([])

// A dictionary from its entries, in the order given.
//
// Nothing is sorted.  `bencwrite.canonical` is where that happens.
//
// ```novo
// use bencvalue
//
// fn main() [io]
//     let d = bencvalue.dict_of([bencvalue.entry("b", BencInt(1)), bencvalue.entry("a", BencInt(2))])
//     println("${bencvalue.keys_sorted(d)}")   // false
// ```
pub fn dict_of(entries: [BencEntry]) -> BencValue []
    BencDict(entries)

// A dictionary with one more entry at the end.  A value that is not a
// dictionary is answered unchanged.
//
// ```novo
// use bencvalue
//
// fn main() [io]
//     println("${bencvalue.len(bencvalue.append(bencvalue.dict(), "a", BencInt(1)))}")   // 1
// ```
pub fn append(d: BencValue, key: Str, value: BencValue) -> BencValue []
    match d
        BencDict(entries) => BencDict(list.concat(entries, [entry(key, value)]))
        _                 => d

// How many entries a dictionary has, or how many elements a list has;
// `0` for an integer or a byte string.
//
// ```novo
// use bencvalue
//
// fn main() [io]
//     println("${bencvalue.len(BencList([BencInt(1)]))}")   // 1
// ```
pub fn len(v: BencValue) -> Int []
    match v
        BencList(items)   => list.len(items)
        BencDict(entries) => list.len(entries)
        _                 => 0

// The fault for a value of the wrong type.
fn wrong(want: Str, v: BencValue) -> BencFault
    BencWrongType(want, type_name(v))

// The integer a value holds, or `BencWrongType`.
//
// ```novo
// use bencvalue
//
// fn main() [io]
//     match bencvalue.as_int(BencInt(7))
//         Ok(n)  => println("${n}")   // 7
//         Err(e) => println(e.message())
// ```
pub fn as_int(v: BencValue) -> Result<Int, BencFault> []
    match v
        BencInt(n) => Ok(n)
        _          => Err(wrong("integer", v))

// The bytes a value holds, or `BencWrongType`.
//
// ```novo
// use std.bytes
// use bencvalue
//
// fn main() [io]
//     match bencvalue.as_bytes(bencvalue.text("ab"))
//         Ok(b)  => println("${bytes.len(b)}")   // 2
//         Err(e) => println(e.message())
// ```
pub fn as_bytes(v: BencValue) -> Result<Bytes, BencFault> []
    match v
        BencBytes(b) => Ok(bytes.clone(b))
        _            => Err(wrong("string", v))

// The bytes a value holds, as text, or `BencWrongType`.
//
// Nothing validates UTF-8: BEP 3 says nothing about the encoding, and a
// torrent's `encoding` member exists because names are not always
// UTF-8.
//
// ```novo
// use bencvalue
//
// fn main() [io]
//     match bencvalue.as_str(bencvalue.text("ubuntu.iso"))
//         Ok(s)  => println(s)   // ubuntu.iso
//         Err(e) => println(e.message())
// ```
pub fn as_str(v: BencValue) -> Result<Str, BencFault> []
    match v
        BencBytes(b) => Ok(bytes.to_str(b))
        _            => Err(wrong("string", v))

// The list a value holds, or `BencWrongType`.
//
// ```novo
// use bencvalue
//
// fn main() [io]
//     match bencvalue.as_list(BencList([]))
//         Ok(xs) => println("${list.len(xs)}")   // 0
//         Err(e) => println(e.message())
// ```
pub fn as_list(v: BencValue) -> Result<[BencValue], BencFault> []
    match v
        BencList(items) => Ok(items[:])
        _               => Err(wrong("list", v))

// The dictionary entries a value holds, or `BencWrongType`.
//
// ```novo
// use bencvalue
//
// fn main() [io]
//     match bencvalue.as_dict(bencvalue.dict())
//         Ok(es) => println("${list.len(es)}")   // 0
//         Err(e) => println(e.message())
// ```
pub fn as_dict(v: BencValue) -> Result<[BencEntry], BencFault> []
    match v
        BencDict(entries) => Ok(entries[:])
        _                 => Err(wrong("dictionary", v))

// An entry's key as text.
//
// ```novo
// use bencvalue
//
// fn main() [io]
//     println(bencvalue.key_str(bencvalue.entry("info", bencvalue.dict())))   // info
// ```
pub fn key_str(e: BencEntry) -> Str []
    bytes.to_str(e.key)

// The value under a key, or `BencNoSuchKey`.  A value that is not a
// dictionary has no keys.
//
// The reader refuses a dictionary with two of one key, so a read value
// has no first-or-last question here.
//
// ```novo
// use bencvalue
//
// fn main() [io]
//     match bencvalue.get(bencvalue.dict(), "announce")
//         Ok(_)  => println("found")
//         Err(e) => println(e.message())   // no key `announce`
// ```
pub fn get(v: BencValue, key: Str) -> Result<BencValue, BencFault> []
    match lookup(v, key)
        Some(x) => Ok(x)
        None    => Err(BencNoSuchKey(key))

// The same lookup as an option, for a caller with a default in hand.
//
// ```novo
// use bencvalue
//
// fn main() [io]
//     match bencvalue.lookup(bencvalue.dict(), "comment")
//         Some(_) => println("found")
//         None    => println("absent")
// ```
pub fn lookup(v: BencValue, key: Str) -> ?BencValue []
    let BencDict(entries) = v else
        return None
    let k = bytes.from_str(key)
    for e in entries
        if e.key == k
            return Some(e.value)
    None

// Whether the dictionary has this key.
//
// ```novo
// use bencvalue
//
// fn main() [io]
//     println("${bencvalue.has(bencvalue.dict(), "info")}")   // false
// ```
pub fn has(v: BencValue, key: Str) -> Bool []
    lookup(v, key) != None

// Every key of a dictionary, as text, in the order the file had them.
//
// ```novo
// use bencvalue
//
// fn main() [io]
//     println("${list.len(bencvalue.keys(bencvalue.dict()))}")   // 0
// ```
pub fn keys(v: BencValue) -> [Str] []
    var out: [Str] = []
    if let BencDict(entries) = v
        for e in entries
            list.push(out, key_str(e))
    out

// Whether `a` sorts before `b` as raw byte strings: unsigned, byte by
// byte, and the shorter first on a common prefix.
fn bytes_before(a: Bytes, b: Bytes) -> Bool
    let n = math.min(bytes.len(a), bytes.len(b))
    for i in 0..n
        let x = bytes.byte_at(a, i) ?? 0
        let y = bytes.byte_at(b, i) ?? 0
        if x != y
            return x < y
    bytes.len(a) < bytes.len(b)

// Whether a dictionary's keys are in the order BEP 3 requires a writer
// to put them in: ascending as raw byte strings.  True for a value that
// is not a dictionary.
//
// It is a question and not a rule at the reader, because files in the
// wild are not always sorted.  Raw bytes are not text in any locale:
// `"Z"` sorts before `"a"` because `0x5A` is below `0x61`.
//
// ```novo
// use bencvalue
//
// fn main() [io]
//     println("${bencvalue.keys_sorted(bencvalue.dict())}")   // true
// ```
pub fn keys_sorted(v: BencValue) -> Bool []
    let BencDict(entries) = v else
        return true
    for i in 1..list.len(entries)
        if not bytes_before(entries[i - 1].key, entries[i].key)
            return false
    true

// The value at a path of dictionary keys, or `None`.
//
// Keys only.  A list index is not a key, and a caller walking into a
// list takes the `BencList` and indexes it.
//
// ```novo
// use bencvalue
//
// fn main() [io]
//     match bencvalue.path(bencvalue.dict(), ["info", "name"])
//         Some(_) => println("found")
//         None    => println("no such path")
// ```
pub fn path(v: BencValue, keys: [Str]) -> ?BencValue []
    var at = v
    for k in keys
        match lookup(at, k)
            Some(x) =>
                at = x
            None    =>
                return None
    Some(at)
