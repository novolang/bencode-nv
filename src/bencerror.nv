// bencerror — every refusal, and the byte offset each of them carries.
//
// Every body is a `todo()`.  The signatures are the design, and the
// compiler checks them as claims; see the README for the stamp.
//
// BENCODE HAS NO WHITESPACE, NO COMMENTS AND NO LINES, so an offset is
// the only place a fault can be.  Every variant here carries one, and
// `bencread.context` cuts the surrounding bytes out for a message.
//
// THE FAULTS THAT ARE NOT HERE are as much of the design as the ones
// that are.  A dictionary whose keys are out of order is NOT a fault:
// BEP 3 requires a writer to sort them and files in the wild do not
// always, and a reader that refused one would refuse torrents that
// every client accepts.  The ordering is a question — `bencwrite.
// is_canonical` — and a writer rule, and never a reason to fail a read.
//
// A DUPLICATE KEY IS a fault, and the distinction is not arbitrary. An
// unsorted dictionary still has one value per key, so a reader knows
// what it holds.  A dictionary with the same key twice does not, and
// for a torrent the consequence is worse than ambiguity: the
// info-hash is taken over the bytes, so two readers that resolved the
// duplicate differently would agree on the hash and disagree on what
// it identifies.

// What went wrong.
pub enum BencFault
    // The buffer ended in the middle of a value.
    BencTruncated(at: Int, need: Int)
    // A byte that cannot begin a value: bencode starts a value with
    // `i`, `l`, `d` or a digit and with nothing else.
    BencUnexpectedByte(at: Int, saw: Int)
    // An integer with a leading zero — `i03e` — which BEP 3 forbids so
    // that every number has one spelling.
    BencIntegerLeadingZero(at: Int)
    // `i-0e`, which BEP 3 names as invalid: there is no negative zero.
    BencNegativeZero(at: Int)
    // An integer with no digits at all, or a `-` with nothing after it.
    BencEmptyInteger(at: Int)
    // An integer whose digits do not fit a signed 64-bit value.
    //
    // BEP 3 puts no bound on the number, and a torrent's `length` for a
    // file larger than eight exabytes would be one.  No such file
    // exists, and refusing is better than wrapping.
    BencIntegerOverflow(at: Int, digits: Str)
    // A byte string whose length has a leading zero.
    BencLengthLeadingZero(at: Int)
    // A byte string whose length is not followed by a colon.
    BencMissingColon(at: Int)
    // A byte string whose declared length runs past the end of the
    // buffer.
    BencLengthOverrun(at: Int, declared: Int, available: Int)
    // A dictionary key that is not a byte string.  BEP 3 permits
    // nothing else there.
    BencNonStringKey(at: Int, saw: Str)
    // A dictionary with the same key twice.  See the note above.
    BencDuplicateKey(at: Int, key: Str)
    // The value nested deeper than the reader's limit.
    //
    // A list head costs one byte and opens a level, so a reader without
    // a limit is a stack overflow that arrives as a short message — and
    // a torrent file is something a stranger sends you.
    BencDepthExceeded(at: Int, depth: Int)
    // A value was read and bytes were left over.
    BencTrailingBytes(at: Int, len: Int)
    // An accessor was asked for one type and the value was another.
    BencWrongType(want: Str, saw: Str)
    // A key the caller asked for is not in the dictionary.
    BencNoSuchKey(key: Str)
    // A torrent is missing a member BEP 3 requires, or has one of the
    // wrong type.
    BencBadTorrent(path: Str, why: Str)
    // A torrent's `pieces` is not a whole number of twenty-byte
    // hashes.
    BencBadPieceTable(len: Int)
    // A torrent that is neither single-file nor multi-file: its `info`
    // has both `length` and `files`, or neither.
    BencAmbiguousTorrentShape(why: Str)
    // A path component in a multi-file torrent that would escape the
    // torrent's own directory: `..`, an absolute component, or an empty
    // one.
    //
    // A REFUSAL AND NOT A SANITISATION.  A caller that was handed a
    // cleaned path would write files where the torrent said, and the
    // whole point is that the torrent said somewhere it should not.
    BencUnsafePath(index: Int, component: Str)

// The standard `Error` implementation, so a bad file can be reported by
// anything that reports errors.
impl Error for BencFault
    // Answer the one-line report: what was wrong, and at what byte
    // offset.
    fn message(self) -> Str
        todo("bencode-nv.bencerror.BencFault.message")

// The byte offset a fault was found at, or `0` for the faults that are
// about a key or a shape rather than a position.
//
// ```novo
// use bencerror
//
// fn main() [io]
//     println("${bencerror.offset_of(BencNegativeZero(4))}")   // 4
// ```
pub fn offset_of(f: BencFault) -> Int []
    todo("bencode-nv.bencerror.offset_of")

// A short, stable name for the fault, for a metric label or a test.
//
// The variant's own spelling with the `Benc` prefix removed and the
// words separated by hyphens: `"integer-leading-zero"`,
// `"duplicate-key"`, `"unsafe-path"`.
//
// ```novo
// use bencerror
//
// fn main() [io]
//     println(bencerror.code_of(BencNegativeZero(4)))   // negative-zero
// ```
pub fn code_of(f: BencFault) -> Str []
    todo("bencode-nv.bencerror.code_of")

// Whether the fault is in the bytes rather than in the request.
//
// False for `BencWrongType` and `BencNoSuchKey`, which say the caller
// asked for something the file does not have.  True for everything
// else, the torrent-shaped faults included: a file that is not a
// torrent is a bad file.
//
// ```novo
// use bencerror
//
// fn main() [io]
//     println("${bencerror.is_file_fault(BencNoSuchKey("announce"))}")   // false
// ```
pub fn is_file_fault(f: BencFault) -> Bool []
    todo("bencode-nv.bencerror.is_file_fault")
